# Copy to .env.local. Never commit real credentials.
DATABASE_URL=
DIRECT_URL=
# Auth.js: genera AUTH_SECRET con `npx.cmd auth secret` (o 32+ bytes aleatorios en base64).
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
# Habilita POST /api/test/reset-data (borra y recrea datos de dominio).
# Solo "true" en Vercel producción y CI E2E. NO lo actives en .env.local.
RESET_DATA_ENABLED=
